# Development defaults to persistent embedded PostgreSQL. Copy this file to .env if overriding defaults.
NODE_ENV=development
APP_URL=http://127.0.0.1:3030
PORT=3030
# HOST=127.0.0.1
# DATABASE_URL=
# DATA_DIR=.data
# APP_SECRET=
# APP_SECRET_PREVIOUS=
# TRUST_PROXY_HOPS=1
# JOBS_IN_SERVER=true

OWNER_USERNAME=zews1009485
# OWNER_EMAIL=
# Set OWNER_PASSWORD only in the protected environment of the owner CLI.

GUEST_CHECKOUT=true
# STORE_TAX_BPS=0
# STORE_SHIPPING_RATE=
# STORE_SHIPPING_COUNTRIES=

# Use provider secrets in the host secret manager.
# COINGECKO_API_KEY=
# COINGECKO_PLAN=demo
# Optional read-only chain evidence. Verification still requires independent attribution.
# CHAIN_LOOKUP_BLOCKCYPHER=false
# BLOCKCYPHER_TOKEN=
# ETHEREUM_RPC_URL=
# SOLANA_RPC_URL=
PAYPAL_MODE=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_MERCHANT_ID=
# PAYPAL_WEBHOOK_ID=
# RESEND_API_KEY=
# MAIL_FROM=
